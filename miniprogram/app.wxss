page { background: #f2f0eb; color: #111111; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif; }
.container { padding: 28rpx; }
.card { background: #ffffff; border: 2rpx solid #111111; border-radius: 0; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 10rpx 10rpx 0 #111111; }
.button-primary { background: #111111; color: #ffffff; border-radius: 0; font-weight: 800; letter-spacing: 2rpx; }
.button-primary::after { border: 0; }
.muted { color: #5d5a54; font-size: 26rpx; }
.empty { color: #5d5a54; text-align: center; padding: 80rpx 20rpx; }
