page { background: #f3fbfc; color: #073b4c; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif; }
.container { padding: 24rpx; }
.card { background: #ffffff; border-radius: 28rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 14rpx 38rpx rgba(7, 59, 76, 0.08); }
.button-primary { background: #073b4c; color: #ffffff; border-radius: 999rpx; font-weight: 700; letter-spacing: 1rpx; }
.muted { color: #5d7982; font-size: 26rpx; }
.empty { color: #78919a; text-align: center; padding: 80rpx 20rpx; }
