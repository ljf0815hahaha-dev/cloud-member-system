.hero{height:310rpx;padding:70rpx 34rpx 0;background:linear-gradient(135deg,#123f3a,#0f766e);color:#fff}.hero-brand{font-size:52rpx;font-weight:800;letter-spacing:4rpx}.hero-subtitle{margin-top:14rpx;color:rgba(255,255,255,.72);font-size:26rpx}.content-offset{margin-top:-108rpx}.banner{height:292rpx;margin-bottom:22rpx;border-radius:24rpx;overflow:hidden;box-shadow:0 16rpx 40rpx rgba(8,51,47,.18)}.banner-image{width:100%;height:100%}.banner-title-card{width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:40rpx;text-align:center;background:linear-gradient(135deg,#e6f4f1,#fff);color:#103b37;font-size:38rpx;font-weight:800}.balance-card{background:linear-gradient(145deg,#102f2c,#0f766e);color:#fff;border-radius:24rpx;padding:34rpx}.balance-top{display:flex;justify-content:space-between}.balance-label{font-size:25rpx;color:rgba(255,255,255,.72)}.member{font-size:26rpx;margin-top:8rpx}.member-badge{border:1rpx solid rgba(255,255,255,.38);border-radius:40rpx;padding:8rpx 18rpx;font-size:22rpx;height:max-content}.balance{font-size:72rpx;font-weight:800;margin:34rpx 0 12rpx}.balance-tip{font-size:22rpx;color:rgba(255,255,255,.6)}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-bottom:20rpx}.quick-card{display:flex;align-items:center;background:#fff;border-radius:20rpx;padding:28rpx 20rpx;box-shadow:0 5rpx 20rpx rgba(17,24,39,.05)}.quick-icon{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;font-size:28rpx;font-weight:700;margin-right:18rpx}.quick-icon.red{color:#b42318;background:#fff0ef}.quick-icon.teal{color:#0f766e;background:#e7f5f2}.quick-title{font-weight:700;font-size:28rpx}.quick-desc{color:#8a929e;font-size:21rpx;margin-top:7rpx}.section-heading{font-weight:700;font-size:30rpx;margin-bottom:10rpx}.service-row{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #eef1f3;color:#5b6470;font-size:24rpx}.service-row:last-child{border-bottom:0}.login-card{text-align:center;background:#fff;border-radius:24rpx;padding:48rpx 30rpx;box-shadow:0 8rpx 28rpx rgba(17,24,39,.06)}.login-title{font-weight:750;font-size:34rpx}.login-desc{color:#7b8490;font-size:25rpx;line-height:1.7;margin:15rpx 0 35rpx}.logout-button{background:transparent!important;color:#8a929e!important;font-size:24rpx;margin-top:12rpx}.logout-button::after{border:0}