.hero{height:422rpx;padding:60rpx 34rpx 0;background:#073b4c;color:#fff;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:540rpx;height:540rpx;border:1rpx solid rgba(176,240,244,.22);border-radius:50%;right:-260rpx;bottom:-360rpx}.hero-row{display:flex;justify-content:space-between;position:relative;z-index:1}.hero-kicker,.book-overline{font-size:20rpx;letter-spacing:3rpx;color:#9ee8e9;font-weight:700}.hero-brand{font-size:59rpx;line-height:1.12;font-weight:800;letter-spacing:2rpx;margin-top:15rpx}.hero-subtitle{position:relative;z-index:1;width:500rpx;margin-top:22rpx;color:rgba(255,255,255,.72);font-size:25rpx;line-height:1.6}.water-mark{font-size:140rpx;line-height:1;color:#65d6db;opacity:.8}.content-offset{margin-top:-112rpx}.book-card{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-end;background:#fff;padding:31rpx 29rpx;border-radius:28rpx;box-shadow:0 18rpx 44rpx rgba(4,46,59,.18);margin-bottom:30rpx}.book-title{font-size:33rpx;font-weight:800;margin:12rpx 0 8rpx}.book-copy{font-size:22rpx;line-height:1.5;color:#61808a;width:360rpx}.book-button{padding:0 25rpx;height:66rpx;line-height:66rpx;border-radius:999rpx;background:#ffb45b;color:#603600;font-size:24rpx;font-weight:800}.balance-card{background:#073b4c;color:#fff;padding:30rpx;border-radius:28rpx}.balance-top{display:flex;justify-content:space-between}.balance-label{font-size:24rpx;color:#b6dce0}.member-badge{border:1rpx solid rgba(255,255,255,.28);border-radius:999rpx;padding:8rpx 14rpx;font-size:18rpx;letter-spacing:2rpx;height:max-content}.balance{font-size:68rpx;font-weight:800;margin-top:16rpx}.balance-tip{font-size:21rpx;color:#a7cbd0;margin-top:8rpx}.section-heading{font-weight:800;font-size:32rpx;margin:30rpx 0 16rpx}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.quick-card{display:flex;align-items:center;background:#fff;border-radius:22rpx;padding:25rpx 18rpx;box-shadow:0 8rpx 24rpx rgba(7,59,76,.06)}.quick-icon{width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:28rpx;font-weight:800;margin-right:15rpx}.quick-icon.orange{background:#fff0db;color:#b96a05}.quick-icon.blue{background:#dff5f7;color:#087d89}.quick-icon.mint{background:#e7f7ef;color:#168060}.quick-icon.navy{background:#e4edf8;color:#235481}.quick-title{font-weight:800;font-size:27rpx}.quick-desc{color:#78919a;font-size:20rpx;margin-top:7rpx}.banner{height:200rpx;margin:28rpx 0;border-radius:24rpx;overflow:hidden}.banner-image{width:100%;height:100%}.banner-title-card{width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:40rpx;text-align:center;background:#dff5f7;color:#073b4c;font-size:34rpx;font-weight:800}.login-card{text-align:left;background:#fff;border-radius:28rpx;padding:38rpx 30rpx}.login-title{font-weight:800;font-size:34rpx}.login-desc{color:#6d858e;font-size:24rpx;line-height:1.7;margin:12rpx 0 28rpx}.logout-button{background:transparent!important;color:#78919a!important;font-size:24rpx;margin-top:12rpx}.logout-button::after{border:0}
