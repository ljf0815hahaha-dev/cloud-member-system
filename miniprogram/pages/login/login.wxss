.login-page{min-height:100vh;background:#f2f0eb}.login-hero{height:474rpx;background:#111;color:#fff;text-align:center;padding-top:48rpx;position:relative;overflow:hidden}.rail{height:8rpx;width:92rpx;background:#e96526;margin:0 auto 26rpx}.logo{display:block;width:152rpx;height:94rpx;margin:auto;background:#fff;object-fit:cover}.brand{font-size:46rpx;font-weight:900;margin-top:18rpx;letter-spacing:3rpx}.brand-en{font-size:18rpx;letter-spacing:3rpx;color:#d6d3cd;margin-top:8rpx;font-weight:800}.slogan{font-size:24rpx;color:#d6d3cd;margin-top:15rpx}.login-panel{margin:-42rpx 28rpx 0;background:#fff;border:2rpx solid #111;border-radius:0;padding:38rpx 30rpx;box-shadow:10rpx 10rpx 0 #111;position:relative}.title{font-size:40rpx;font-weight:900;margin-bottom:14rpx}.muted{line-height:1.7;color:#5d5a54}.benefits{margin:34rpx 0;color:#242220;font-size:25rpx}.benefits view{margin:19rpx 0;display:flex;align-items:center}.benefits text{display:inline-flex;align-items:center;justify-content:center;width:47rpx;height:35rpx;background:#111;color:#fff;margin-right:15rpx;font-size:18rpx;font-weight:900}.login-type{margin-top:30rpx;font-size:22rpx;font-weight:900;letter-spacing:2rpx;color:#5d5a54}.staff-type{padding-top:27rpx;border-top:2rpx solid #111}.privacy-consent{display:flex;align-items:flex-start;gap:14rpx;margin-top:18rpx;color:#5d5a54;font-size:22rpx;line-height:1.6}.consent-box{flex:0 0 30rpx;width:30rpx;height:30rpx;margin-top:3rpx;border:2rpx solid #111;color:#fff;background:#fff;text-align:center;line-height:27rpx;font-size:21rpx;font-weight:900}.consent-box.checked{background:#111}.privacy-link{color:#111;text-decoration:underline;font-weight:900}.login-button{margin-top:16rpx;border-radius:0;height:96rpx}.staff-button{margin-top:16rpx;width:100%;height:96rpx;line-height:92rpx;border:2rpx solid #111;border-radius:0;background:#fff;color:#111;font-size:28rpx;font-weight:900;letter-spacing:1rpx}.staff-button::after{border:0}.privacy{text-align:center;color:#77736c;font-size:21rpx;margin-top:25rpx}
