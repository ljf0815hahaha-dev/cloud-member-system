.login-page{min-height:100vh;background:#f3f7f6}.login-hero{height:430rpx;background:linear-gradient(145deg,#103b37,#0f766e);color:#fff;text-align:center;padding-top:82rpx}.logo{width:108rpx;height:108rpx;margin:auto;display:flex;align-items:center;justify-content:center;border-radius:30rpx;background:rgba(255,255,255,.13);font-size:54rpx;font-weight:800;border:1rpx solid rgba(255,255,255,.22)}.brand{font-size:44rpx;font-weight:800;margin-top:24rpx;letter-spacing:4rpx}.slogan{font-size:24rpx;color:rgba(255,255,255,.65);margin-top:12rpx}.login-panel{margin:-58rpx 28rpx 0;background:#fff;border-radius:28rpx;padding:42rpx 34rpx;box-shadow:0 18rpx 45rpx rgba(17,55,51,.12)}.title{font-size:40rpx;font-weight:800;margin-bottom:14rpx}.muted{line-height:1.7}.benefits{margin:34rpx 0;color:#475350;font-size:25rpx}.benefits view{margin:17rpx 0}.benefits text{display:inline-flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border-radius:50%;background:#e7f5f2;color:#0f766e;margin-right:15rpx}.login-button{margin-top:38rpx;border-radius:14rpx;height:92rpx}.privacy{text-align:center;color:#9aa29f;font-size:21rpx;margin-top:25rpx}