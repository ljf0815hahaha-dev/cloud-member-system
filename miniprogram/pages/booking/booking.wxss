.head{position:relative;overflow:hidden;padding:48rpx 34rpx 126rpx;background:#073b4c;color:#fff}.head:after{content:"";position:absolute;right:-72rpx;bottom:-110rpx;width:300rpx;height:300rpx;border:2rpx solid rgba(255,255,255,.16);border-radius:50%;box-shadow:0 0 0 38rpx rgba(255,255,255,.04),0 0 0 76rpx rgba(255,255,255,.025)}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#8ee8e5;font-weight:700}.title{position:relative;z-index:1;font-size:52rpx;font-weight:800;letter-spacing:-1rpx;margin-top:12rpx}.subtitle{position:relative;z-index:1;font-size:24rpx;color:rgba(255,255,255,.7);margin-top:12rpx}.content{margin-top:-76rpx;position:relative;z-index:2}.section-title{font-size:29rpx;font-weight:800;color:#073b4c;margin:12rpx 0 18rpx}.card{border-radius:28rpx;padding:10rpx 26rpx;box-shadow:0 18rpx 42rpx rgba(7,59,76,.1)}.field{display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid #e3eff0;padding:27rpx 0;font-size:28rpx;color:#123e49}.field:last-child{border:0}.field text{font-size:38rpx;color:#0fa3b1}.hint{font-size:23rpx;color:#6c858a;line-height:1.7}.submit{margin-top:36rpx;height:98rpx;border-radius:49rpx;background:#ffb45b;color:#522d00;font-size:30rpx;font-weight:800;box-shadow:0 12rpx 24rpx rgba(255,180,91,.28)}.history-title{margin:46rpx 0 18rpx}.history{position:relative;display:flex;justify-content:space-between;align-items:center;padding:25rpx 0}.history:before{content:"";position:absolute;left:0;top:0;right:0;height:1rpx;background:#dcebed}.history-main{font-size:29rpx;font-weight:800;color:#073b4c;margin-bottom:11rpx}.history .hint{font-size:22rpx}.status{font-size:22rpx;color:#087d87;background:#dff8f7;padding:10rpx 17rpx;border-radius:30rpx;font-weight:700}
