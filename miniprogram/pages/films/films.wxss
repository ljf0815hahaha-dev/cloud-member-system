.archive-head{background:linear-gradient(135deg,#103b37,#0f766e);color:#fff;padding:44rpx 34rpx 82rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#99f6e4;font-weight:700}.title{font-size:44rpx;font-weight:800;margin-top:12rpx}.subtitle{font-size:23rpx;color:rgba(255,255,255,.65);margin-top:10rpx}.archive-list{margin-top:-42rpx}.record-card{border-radius:20rpx;padding:28rpx}.record-head{display:flex;justify-content:space-between}.date{font-size:32rpx;font-weight:800}.remark{margin-top:10rpx;color:#626d6b;font-size:25rpx}.count{background:#e7f5f2;color:#0f766e;border-radius:30rpx;padding:8rpx 16rpx;height:max-content;font-size:21rpx}.images{white-space:nowrap;width:100%;margin-top:24rpx}.images image{display:inline-block;width:240rpx;height:190rpx;border-radius:14rpx;margin-right:12rpx}.record-footer{display:flex;justify-content:space-between;margin-top:20rpx;padding-top:17rpx;border-top:1rpx solid #edf0ef;color:#8a9492;font-size:21rpx}.structured{margin-top:22rpx;padding:18rpx;background:#f6f9f8;border-radius:14rpx;color:#344441;font-size:23rpx}.structured view{margin:8rpx 0}.structured text{display:inline-block;width:130rpx;color:#7b8987}