<view class="archive-head"><view class="eyebrow">SERVICE ARCHIVE</view><view class="title">我的贴膜档案</view><view class="subtitle">门店施工完成后上传，顾客只可查看</view></view>
<view class="container archive-list">
  <view class="card record-card" wx:for="{{records}}" wx:key="_id">
    <view class="record-head"><view><view class="date">{{item.isCertificate ? "质保凭证" : item.timeText}}</view><view class="remark">{{item.remark || "贴膜服务记录"}}</view></view><view class="count">{{item.images.length}} 张</view></view>
    <view class="structured" wx:if="{{item.isCertificate}}"><view><text>客户姓名</text>{{item.memberName}}</view><view><text>联系电话</text>{{item.memberMobile}}</view><view><text>汽车品牌</text>{{item.vehicleSnapshot.brand || "未填写"}}</view><view><text>车牌号码</text>{{item.vehicleSnapshot.plateNumber || "未填写"}}</view><view><text>施工门店</text>{{item.storeText}}</view><view><text>施工日期</text>{{item.timeText}}</view><view><text>施工价格</text>{{item.priceText}}</view><view><text>产品类型</text>{{item.productText}}</view><view><text>施工部位</text>{{item.positionText}}</view><view><text>卷膜编号</text>{{item.rollNumberText}}</view><view><text>产品型号</text>{{item.modelText}}</view><view><text>质保年限</text>{{item.warrantyText}}</view><view wx:if="{{item.mileageKm}}"><text>施工里程</text>{{item.mileageKm}} km</view></view>
    <view class="structured" wx:else><view><text>车辆</text>{{item.vehicleText}}</view><view><text>膜信息</text>{{item.productText}}</view><view><text>施工位置</text>{{item.positionText}}</view><view><text>质保</text>{{item.warrantyText}}</view><view wx:if="{{item.mileageKm}}"><text>施工里程</text>{{item.mileageKm}} km</view></view>
    <scroll-view class="images" scroll-x wx:if="{{item.images.length}}"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" src="{{image}}" mode="aspectFill" data-images="{{item.images}}" data-current="{{image}}" bindtap="preview" /></scroll-view>
    <view class="record-footer"><text>服务资料已归档</text><text>点击照片查看大图</text></view>
  </view><view class="empty" wx:if="{{!records.length}}">暂无贴膜档案</view>
</view>
