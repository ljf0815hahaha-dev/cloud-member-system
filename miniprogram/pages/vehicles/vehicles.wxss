.vehicle-head{background:linear-gradient(135deg,#103b37,#0f766e);color:#fff;padding:44rpx 34rpx 82rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#99f6e4;font-weight:700}.title{font-size:44rpx;font-weight:800;margin-top:12rpx}.subtitle{font-size:23rpx;color:rgba(255,255,255,.65);margin-top:10rpx}.vehicle-list{margin-top:-42rpx}.vehicle-card{padding:28rpx;border-radius:20rpx}.plate-row{display:flex;align-items:center;justify-content:space-between}.plate{font-size:38rpx;font-weight:800;letter-spacing:2rpx}.default{background:#e7f5f2;color:#0f766e;border-radius:30rpx;padding:8rpx 16rpx;font-size:21rpx}.model{font-size:28rpx;margin-top:20rpx}.details{display:flex;flex-direction:column;gap:10rpx;color:#71807e;font-size:23rpx;margin-top:16rpx;word-break:break-all}
