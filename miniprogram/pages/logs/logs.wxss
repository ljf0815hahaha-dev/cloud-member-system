.summary{display:grid;grid-template-columns:1fr 1fr;background:#111;color:#fff;padding:42rpx 30rpx 70rpx}.summary>view{padding-left:24rpx;border-left:1rpx solid #666}.summary text{display:block;color:#d6d3cd;font-size:23rpx}.summary strong{display:block;font-size:42rpx;margin-top:10rpx;font-weight:900}.logs-container{margin-top:-34rpx}.filters{display:flex;background:#fff;border:2rpx solid #111;padding:8rpx;margin-bottom:24rpx;box-shadow:8rpx 8rpx 0 #111}.filters button{flex:1;background:transparent;font-size:25rpx;color:#5d5a54}.filters button::after{border:0}.filters button.active{background:#111;color:#fff;font-weight:900}.log-card{border-radius:0}.row{display:flex;justify-content:space-between;align-items:center}.type-badge{font-size:21rpx;padding:6rpx 12rpx;margin-right:14rpx;font-weight:800}.type-badge.recharge{background:#f5dfd2;color:#111}.type-badge.settlement{background:#e5e1d9;color:#111}.item-title{font-weight:900;font-size:28rpx}.amount{font-size:36rpx;font-weight:900}.amount.recharge{color:#b42318}.amount.settlement{color:#111}.detail{display:flex;gap:26rpx;background:#f2f0eb;border-left:5rpx solid #e96526;padding:15rpx;margin-top:20rpx;color:#3d3933;font-size:23rpx}.footer{display:flex;justify-content:space-between;margin-top:18rpx;color:#5d5a54;font-size:21rpx}
