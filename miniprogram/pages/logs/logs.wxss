.summary{display:grid;grid-template-columns:1fr 1fr;background:linear-gradient(135deg,#103b37,#0f766e);color:#fff;padding:42rpx 30rpx 70rpx}.summary>view{padding-left:24rpx;border-left:1rpx solid rgba(255,255,255,.25)}.summary text{display:block;color:rgba(255,255,255,.65);font-size:23rpx}.summary strong{display:block;font-size:42rpx;margin-top:10rpx}.logs-container{margin-top:-34rpx}.filters{display:flex;background:#fff;border-radius:16rpx;padding:8rpx;margin-bottom:20rpx;box-shadow:0 8rpx 24rpx rgba(17,24,39,.06)}.filters button{flex:1;background:transparent;font-size:25rpx;color:#7b8490}.filters button::after{border:0}.filters button.active{background:#e7f5f2;color:#0f766e;font-weight:700}.log-card{border-radius:18rpx}.row{display:flex;justify-content:space-between;align-items:center}.type-badge{font-size:21rpx;padding:6rpx 12rpx;border-radius:20rpx;margin-right:14rpx}.type-badge.recharge{background:#fff0ef;color:#b42318}.type-badge.settlement{background:#e7f5f2;color:#0f766e}.item-title{font-weight:700;font-size:28rpx}.amount{font-size:36rpx;font-weight:800}.amount.recharge{color:#c62828}.amount.settlement{color:#0f766e}.detail{display:flex;gap:26rpx;background:#f6f8f8;border-radius:10rpx;padding:15rpx;margin-top:20rpx;color:#65716f;font-size:23rpx}.footer{display:flex;justify-content:space-between;margin-top:18rpx;color:#8b9492;font-size:21rpx}